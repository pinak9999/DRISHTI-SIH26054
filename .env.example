# ==============================================================================
# DRISHTI — AI-Enabled Aero Piston Engine Digital Twin (SIH26054 | DRDO)
# Example Environment Configuration (Safe Placeholders Only — No Secrets)
# ==============================================================================

# FastAPI Backend Server Settings
DRISHTI_HOST=127.0.0.1
DRISHTI_PORT=8000
DRISHTI_ENV=development
DRISHTI_LOG_LEVEL=INFO

# CORS Allowed Origins (comma-separated for frontend dev/prod servers)
DRISHTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# SQLite WAL Database & Model Artifact Paths (relative to project root or absolute)
DRISHTI_DB_PATH=backend/artifacts/drishti_twin.db
DRISHTI_ARTIFACT_DIR=backend/artifacts
DRISHTI_AUTO_SEED_DEMO_FLEET=true

# Telemetry Ingestion & CAN / SocketCAN Interface Settings
# Modes: SOFTWARE_CODEC_READY_NO_HARDWARE | SOCKETCAN_LIVE
DRISHTI_SIMULATION_MODE=true
DRISHTI_CAN_INTERFACE=can0
DRISHTI_CAN_BITRATE=500000
DRISHTI_MAX_CSV_UPLOAD_ROWS=5000

# Default Hybrid Health Index Penalty Weights (Must sum to 1.0)
DRISHTI_HI_WEIGHT_THERMAL=0.30
DRISHTI_HI_WEIGHT_OIL=0.30
DRISHTI_HI_WEIGHT_VIBRATION=0.20
DRISHTI_HI_WEIGHT_ANOMALY=0.20

# Default Mission Readiness Advisory Thresholds (Prototype Advisory Only)
DRISHTI_GO_MIN_HI=75.0
DRISHTI_PRECAUTION_MIN_HI=55.0
DRISHTI_GO_MIN_RUL_HOURS=15.0
DRISHTI_PRECAUTION_MIN_RUL_HOURS=5.0

# Frontend Vite API Target (used by frontend if configured)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
